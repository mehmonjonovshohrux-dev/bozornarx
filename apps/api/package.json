{
  "name": "@bozornarx/api",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/domain/*.test.ts",
    "smoke": "node scripts-smoke.mjs",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed:reference": "node dist/scripts/seed-reference.js",
    "seed:demo": "node dist/scripts/seed-demo.js",
    "create:admin": "node dist/scripts/create-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^8.40.0",
    "helmet": "^7.1.0",
    "prisma": "^5.22.0",
    "web-push": "^3.6.7",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.7.2"
  }
}
