# Copy to apps/api/.env (local). On Render set these in the dashboard. Never commit real values.

# ---- API (apps/api) ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://bozornarx:CHANGE_ME@localhost:5432/bozornarx
JWT_ACCESS_SECRET=          # >=32 random chars:  openssl rand -base64 48
OTP_HASH_PEPPER=            # >=32 random chars, different from the JWT secret
WEB_ORIGIN=http://localhost:3000     # exact URL of the web app (CORS)
APP_URL=http://localhost:3000        # used for links inside emails
TRUST_PROXY=0                        # number of proxies in front of the API; 1 on Render
SWAGGER=true                         # false in production unless needed

# Email through Google Apps Script (see apps/mail-script/README.md)
MAIL_MODE=apps_script                # apps_script | disabled (disabled is refused in production)
GAS_URL=                             # Web App URL ending in /exec
GAS_SECRET=                          # must equal MAIL_SECRET in Script Properties (>=32 chars)

SMS_PROVIDER_MODE=mock               # no real SMS provider yet: phone OTP answers 503
SENTRY_DSN=                          # optional

# Web push (optional): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Official integrations. Leave "disabled" until you have the provider's credentials; the API then answers 503 honestly.
EIMZO_MODE=disabled                  # disabled | enabled
EIMZO_API_URL=                       # verification service URL given by the E-IMZO provider
PAYMENT_PROVIDER_MODE=none           # none | (provider code once an adapter is implemented)

# ---- Web (apps/web) ----
API_URL=http://localhost:4000        # read at BUILD time (Next rewrites /api/* to it)

# ---- Only for `npm run create:admin` ----
ADMIN_EMAIL=
ADMIN_PASSWORD=                      # >=12 chars
ADMIN_NAME=
MAINTENANCE_ENABLED=true              # set false to disable background housekeeping
